body {
    background-color: var(--color-light);
}

/* Header */
.header {
    border-bottom: 2px solid var(--color-blue-dark);
}
.header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 15px;
    padding-bottom: 15px;
    column-gap: 40px;
}


.search-input {
    width: 100%;
}

.header-top {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 15px;
}

.header-actions {
    display: flex;
    align-items: center;
    column-gap: 20px;
}

.header-actions-create {
    white-space: nowrap;
}

/* Questions */
.questions {
    padding-top: 30px;
    padding-bottom: 20px;
    display: flex;
    flex-direction: column;
    row-gap: 30px;
}

.tall-container {
    padding-bottom: 100px;
}

.questions-content-list {
    display: flex;
    flex-direction: column;
}
.questions-content-item {
    display: flex;
    position: relative;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    min-height: 100px;
    border-bottom: 1px solid var(--color-blue-dark);
    border-left: var(--border);
    border-color: var(--color-blue-dark);
    padding: 15px;
    padding-top: 30px;
}
.questions-item-filter {
    display: flex;
    gap: 30px;
}
.questions-item-header {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 18px;
    font-weight: 700;
}
.questions-item-header > div {
    overflow: hidden;
}

.questions-item-footer {
    display: flex;
    justify-content: flex-start;
}

.questions-item-body {
    white-space: pre-wrap;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* create */
.overlay {
    position: fixed;
    display: none;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
}
.overlay.active {
    display: block;
}
.create {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: var(--color-light);
    width: 50%;
    height: 70%;
    max-width: 900px;
    max-height: 600px;
    border-radius: 10px;
    padding: 45px 15px;
    display: flex;
    flex-direction: column;
}

.create-form {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
    height: 100%;
    overflow-y: auto;
}

.create-form-text {
    display: flex;
    flex-direction: column;
    row-gap: 5px;
    height: 100%;
    min-height: 50%;
}
.item-filter {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    border: none;
    border-bottom: var(--border);
    background-color: transparent;
    outline: 0;
    padding-bottom: 10px;
    padding-top: 10px;
    font-size: 16px;
    width: 100%;
    color: var(--color-blue-dark);
    border-radius: 0;
}
.form-text-textarea {
    height: 100%;
    background: transparent;
    resize: none;
    outline: none;
    padding: 15px;
    border: var(--border);
    border-radius: 10px;
    transition: border-color 0.2s, box-shadow 0.2s;
    color: var(--color-blue-dark);
}

.form-text-textarea-answer {
    height: 100%;
    background: transparent;
    resize: none;
    outline: none;
    padding: 15px;
    border: var(--border);
    border-radius: 10px;
    transition: border-color 0.2s, box-shadow 0.2s;
    color: var(--color-blue-dark);
    overflow: auto;
}



.form-text-textarea:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(0,0,0,0.2);
}

.create-form-section {
    display: flex;
    width: 100%;
    column-gap: 15px;
}

.create-close-btn {
    position: absolute;
    top: 15px;
    right: 5px;
    border: none;
    background-color: transparent;
    border-radius: 15px;
}


/* upload */
.upload-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.upload-label {
    display: flex;
    align-items: center;
    gap: 10px;
}

.file-item {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;  
}

.file-item:hover {
    text-decoration: underline;
}

/* admin */
.admin-container {
    padding-top: 30px;
    padding-bottom: 20px;
    display: flex;
    flex-direction: column;
    row-gap: 10px;
    justify-content: center;
}

.admin-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.admin-btn {
    margin-inline: auto;
}

.admin-input {
    width: 50%;
}

.error {
    text-align: center;
    color: var(--color-red);
}

.success {
    text-align: center;
    color: var(--color-green-dark);
}


@media (max-width: 1024px) {
    /* create */
    .create {
        width: 65%;
        height: 75%;
    }
}

@media (max-width: 767px) {
    /* header */
    .header-inner {
        flex-direction: column;
        align-items: flex-start;
        row-gap: 10px;
    }
    .header-actions-create {
        order: 1;
    }
    .header-actions {
        width: 100%;
        justify-content: space-between; /* кнопки слева */
    }
    /* questions */
    .questions-filter-list {
        min-width: 180px;
    }

    /* create */
    .create {
        width: 75%;
        height: 75%;
    }

    .admin-input {
        width: 80%;
    }
}

@media (max-width: 480px) {
    /* Content */
    .questions-item-filter {
        gap: 10px;
    }
    .create-form-text {
        min-height: 90%;
    }
}